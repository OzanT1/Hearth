# Rebuild small Go executables with patched toolchain/modules instead of retaining
# the older embedded Go runtimes shipped in the upstream service images.
ARG CADDY_VERSION=2.11.9
ARG GO_VERSION=1.27.4
FROM golang:${GO_VERSION}-alpine AS gosu-build
WORKDIR /build
RUN go mod init hearth/gosu-build \
    && go get github.com/tianon/gosu@1.19 github.com/moby/sys/user@v0.4.1 golang.org/x/sys@v0.44.0 \
    && CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-s -w" -o /out/gosu github.com/tianon/gosu

FROM golang:${GO_VERSION}-alpine AS caddy-build
ARG CADDY_VERSION
WORKDIR /build
# Use the Smallstep Go JOSE v4 migration pinned by Caddy PR #8368.
RUN go mod init hearth/caddy-build \
    && go get github.com/caddyserver/caddy/v2@v${CADDY_VERSION} \
        github.com/smallstep/certificates@v0.30.3-0.20261105213751-6d5a251fbe01 \
        go.step.sm/crypto@v0.92.0 golang.org/x/net@v0.62.0 \
    && CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-s -w" -o /out/caddy github.com/caddyserver/caddy/v2/cmd/caddy
# GO-2026-5932 concerns only obsolete OpenPGP packages, not the other x/crypto
# packages Caddy uses. Fail the build if a future dependency starts importing it.
RUN go list -deps github.com/caddyserver/caddy/v2/cmd/caddy > /out/caddy-packages.txt \
    && if grep -q '^golang.org/x/crypto/openpgp' /out/caddy-packages.txt; then echo 'Unsafe OpenPGP import detected'; exit 1; fi

FROM postgres:17-alpine AS postgres
RUN apk upgrade --no-cache
COPY --from=gosu-build /out/gosu /usr/local/bin/gosu
RUN gosu nobody true

FROM redis:7.4-alpine AS redis
RUN apk upgrade --no-cache

FROM caddy:${CADDY_VERSION}-alpine AS caddy
RUN apk upgrade --no-cache
COPY --from=caddy-build /out/caddy /usr/bin/caddy
COPY --from=caddy-build /out/caddy-packages.txt /usr/local/share/caddy-packages.txt
RUN caddy version
